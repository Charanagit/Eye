*.keras
*.h5
*.npy
*.pt
*.pth
!models/**/.gitkeep

# Environment & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini
*.pem
